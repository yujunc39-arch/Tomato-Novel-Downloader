# ===== 多租户 Web 平台 配置模板 =====
# 复制为 .env 后填写；安装脚本会自动 chmod 600

# 【必填】主域名。子域名将是 u1.<TOMATO_DOMAIN>、u2.<TOMATO_DOMAIN> ...
TOMATO_DOMAIN=tomato.example.com

# 【可选】JWT 签名密钥。留空则 install.sh 自动生成随机值。
# 改动会使所有已登录会话失效。
TOMATO_SECRET=

# 【可选】证书路径，默认 /etc/letsencrypt/live/<TOMATO_DOMAIN>/
# TOMATO_CERT=/etc/letsencrypt/live/tomato.example.com/fullchain.pem
# TOMATO_CERTKEY=/etc/letsencrypt/live/tomato.example.com/privkey.pem

# 【可选】安装脚本用：创建的首个超级管理员
# TOMATO_ADMIN_USER=admin
# TOMATO_ADMIN_PASS=

# 【可选】Cloudflare Turnstile 真人校验
# 不配置 = 关闭该功能；配置后所有访客进入站点都要先过验证（超级管理员豁免）
# 获取：https://dash.cloudflare.com → Turnstile → 添加站点
# TURNSTILE_SITEKEY=0x4AAAAAAAxxxxxxxxxxxxxxxx
# TURNSTILE_SECRET=0x4AAAAAAAxxxxxxxxxxxxxxxx

# 【可选】Cloudflare API Token（用于自动添加 DNS 记录 + 申请泛域名证书）
# 需要 Zone:DNS:Edit 权限
# CF_API_TOKEN=
